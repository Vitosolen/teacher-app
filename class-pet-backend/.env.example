# 数据库连接串
# MySQL（生产/团队部署）：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/class_pet?charset=utf8mb4
# SQLite（本地开发/快速验证）：
DATABASE_URL=sqlite:///./class_pet.db

# JWT 配置
JWT_SECRET=please-change-me-in-production-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS 允许的前端来源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
